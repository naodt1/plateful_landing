# Copy to .env.local for local dev, and set the same keys in Vercel for prod.

# Server-only. Shared secret the Deno Deploy recipe endpoints require, so the
# public endpoints reject calls that don't come from Plateful. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix).
PLATEFUL_APP_SECRET=

# Firebase web app config (project plateful-d10ff). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
